#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

ENTRY="${BASH_SOURCE[0]}"
while [[ -L "$ENTRY" ]]; do
  ENTRY_DIR="$(cd -P -- "$(dirname -- "$ENTRY")" >/dev/null 2>&1 && pwd)"
  ENTRY="$(readlink "$ENTRY")"; [[ "$ENTRY" == /* ]] || ENTRY="$ENTRY_DIR/$ENTRY"
done
ROOT_DIR="${KEINE_ROOT:-$(cd -P -- "$(dirname -- "$ENTRY")/.." >/dev/null 2>&1 && pwd)}"
# 后续加载的软件目录模块消费该全局路径；单文件分析无法跟踪动态 source。
# shellcheck disable=SC2034
CONFIG_DIR="${KEINE_CONFIG_DIR:-$ROOT_DIR/config}"
KEINE_VERSION="$(tr -d '[:space:]' < "$ROOT_DIR/VERSION")"
INSTALL_METADATA="$ROOT_DIR/config/installation.conf"
if [[ -r "$INSTALL_METADATA" ]]; then
  # 由安装器生成，只包含经过 shell 转义的安装路径。
  # shellcheck source=/dev/null
  . "$INSTALL_METADATA"
  KEINE_LOG_ROOT="${KEINE_LOG_ROOT:-/var/log/keine}"
  export KEINE_BACKUP_ROOT KEINE_DOCKER_BACKUP_ROOT KEINE_LOG_ROOT KEINE_STATE_ROOT
  KEINE_AUDIT_LOG="${KEINE_AUDIT_LOG:-$KEINE_LOG_ROOT/actions.log}"
  export KEINE_AUDIT_LOG
fi

. "$ROOT_DIR/src/core/runtime.sh"
. "$ROOT_DIR/src/core/validation.sh"
. "$ROOT_DIR/src/core/ui.sh"
. "$ROOT_DIR/src/core/platform.sh"
. "$ROOT_DIR/src/core/changes.sh"
. "$ROOT_DIR/src/core/backup.sh"
. "$ROOT_DIR/src/core/configuration.sh"
. "$ROOT_DIR/src/features/software.sh"
. "$ROOT_DIR/src/features/software/releases.sh"
. "$ROOT_DIR/src/features/terminal.sh"
. "$ROOT_DIR/src/features/software/catalog.sh"
. "$ROOT_DIR/src/features/dashboard.sh"
. "$ROOT_DIR/src/features/system.sh"
. "$ROOT_DIR/src/features/network.sh"
. "$ROOT_DIR/src/features/security.sh"
. "$ROOT_DIR/src/features/services.sh"
. "$ROOT_DIR/src/features/apps/docker.sh"
. "$ROOT_DIR/src/features/apps.sh"
. "$ROOT_DIR/src/features/backups.sh"
. "$ROOT_DIR/src/features/maintenance.sh"
. "$ROOT_DIR/src/features/recovery.sh"
. "$ROOT_DIR/src/integrations.sh"
. "$ROOT_DIR/src/core/navigation.sh"

usage() {
  printf 'keine %s\n\n' "$KEINE_VERSION"
  cat <<'EOF'
用法：
  keine                       打开交互控制台
  keine status                显示一次性只读运维总览
  keine doctor                检查运行环境与项目完整性
  keine triage                运行只读故障快速排查
  keine updates               查看系统软件包更新清单
  keine system-update         预览并确认更新当前 VPS 系统
  keine storage               显示只读存储概览
  keine swap                  打开 Swap 生命周期管理
  keine process PID           查看并管理一个进程
  keine software [ID]         打开软件中心或指定软件详情
  keine list [关键词]         查询软件目录
  keine sources               按维护来源浏览软件
  keine official-updates      检查已安装官方 Release 更新
  keine exposure              分析公网监听、进程、容器与 UFW
  keine install ID            安装一个软件
  keine update ID             更新一个已安装软件
  keine remove ID             移除一个软件
  keine ports                 查看监听端口
  keine dns [域名]            诊断系统 DNS 解析
  keine dns-config             配置或恢复主机系统 DNS
  keine proxy                  配置与管理已有 SOCKS5 出站代理
  keine proxy-check URL        使用保存的代理验证 HTTP/HTTPS 请求
  keine net-tuning             管理可撤销的原生网络参数
  keine tuning-adapters        第三方调优适配预留与参数来源检查
  keine probe HOST PORT       探测目标 TCP 端口
  keine http URL              诊断 HTTP/HTTPS HEAD 状态、TLS 与耗时
  keine trace HOST            查看目标链路路径
  keine interface IFACE       查看一个网络接口详情
  keine system                打开系统管理中心
  keine network               打开网络与端口中心
  keine security              打开安全中心
  keine auth-activity         汇总最近 24 小时 SSH 登录活动
  keine services              打开服务与日志中心
  keine service SERVICE       打开一个 systemd 服务的管理页
  keine service SERVICE ACTION
                                  执行 start/stop/restart/enable/disable
  keine journal               打开 Journal 管理
  keine logs SERVICE          查看一个 systemd 服务的最近日志
  keine apps                  打开应用与容器中心
  keine app ID                打开一个已安装应用的专属详情
  keine compose PROJECT       管理一个现有 Docker Compose 项目
  keine backups               打开备份与恢复中心
  keine terminal              终端框架与提示符一键切换
  keine terminal-check        诊断提示符未生效、登录 Shell 与初始化文件
  keine warp                  管理原生 WARP / wgcf 隧道
  keine recovery              配置快照与项目变更撤销
  keine changes               查看与撤销项目记录的修改
  keine project               项目维护、更新与卸载
  keine backup-delete SNAPSHOT
                                  删除一个明确选择的项目快照
  keine backup-cleanup        按保留数量或天数清理历史快照
  keine about                 显示项目与安装信息
  keine self-update           更新 keine
  keine uninstall             卸载 keine
  keine version               显示版本

选项：
  --dry-run                       预览修改命令
  --no-color                      禁用颜色
  -V, --version                   显示版本
  -h, --help                      显示帮助

工具仅在命令运行期间工作，不创建后台监控或自动任务。修改动作始终需要人工确认；
软件安装、更新和移除一次只接受一个软件 ID。
EOF
}

main_menu() {
  navigation_menu
}

main() {
  local command="menu" command_set=0 record service
  local arguments=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        # 由随后加载的运行时与功能模块消费。
        # shellcheck disable=SC2034
        DRY_RUN=1
        ;;
      --no-color)
        # 由随后加载的 UI 模块消费。
        # shellcheck disable=SC2034
        NO_COLOR=1
        ;;
      -V|--version) printf 'keine %s\n' "$KEINE_VERSION"; return 0 ;;
      -h|--help|help) runtime_init; usage; return 0 ;;
      --*) die "未知选项：$1" ;;
      *) if [[ "$command_set" -eq 0 ]]; then command="$1"; command_set=1; else arguments+=("$1"); fi ;;
    esac
    shift
  done
  runtime_init
  case "$command" in
    menu) ((${#arguments[@]}==0)) || die "menu 不接受参数"; main_menu ;;
    status)
      ((${#arguments[@]} == 0)) || die "status 不接受参数"
      dashboard_show
      ;;
    doctor)
      ((${#arguments[@]} == 0)) || die "doctor 不接受参数"
      toolkit_doctor
      ;;
    triage)
      ((${#arguments[@]} == 0)) || die "triage 不接受参数"
      system_triage 0
      ;;
    updates)
      ((${#arguments[@]} == 0)) || die "updates 不接受参数"
      platform_detect_identity
      system_package_health 0
      ;;
    system-update)
      ((${#arguments[@]} == 0)) || die "system-update 不接受参数"
      platform_detect_identity
      system_update_menu
      ;;
    storage)
      ((${#arguments[@]} == 0)) || die "storage 不接受参数"
      platform_detect_identity
      system_disk_usage 0
      ;;
    swap)
      ((${#arguments[@]} == 0)) || die "swap 不接受参数"
      system_swap_manage
      ;;
    process)
      ((${#arguments[@]} == 1)) || die "process 需要且只接受一个 PID"
      valid_pid "${arguments[0]}" || die "PID 格式无效"
      process_exists "${arguments[0]}" || die "进程不存在：${arguments[0]}"
      system_process_select "${arguments[0]}"
      ;;
    list)
      ((${#arguments[@]} <= 1)) || die "list 最多接受一个关键词"
      platform_detect_identity
      catalog_print "${arguments[0]:-}"
      ;;
    software)
      ((${#arguments[@]} <= 1)) || die "software 最多接受一个软件 ID"
      platform_detect_identity
      if ((${#arguments[@]} == 0)); then
        software_catalog_menu
      else
        catalog_record "${arguments[0]}" >/dev/null 2>&1 || die "未知软件 ID：${arguments[0]}"
        catalog_item_menu "${arguments[0]}"
      fi
      ;;
    sources)
      ((${#arguments[@]} == 0)) || die "sources 不接受参数"
      platform_detect_identity
      catalog_sources_view
      ;;
    official-updates)
      ((${#arguments[@]} == 0)) || die "official-updates 不接受参数"
      platform_detect_identity
      catalog_official_updates_view 0
      ;;
    exposure)
      ((${#arguments[@]} == 0)) || die "exposure 不接受参数"
      platform_detect_identity
      security_exposure_analysis 0
      ;;
    install)
      ((${#arguments[@]} == 1)) || die "install 一次只能接受一个软件 ID"
      platform_detect_identity
      catalog_install "${arguments[0]}"
      ;;
    update)
      ((${#arguments[@]} == 1)) || die "update 一次只能接受一个软件 ID"
      platform_detect_identity
      catalog_update "${arguments[0]}"
      ;;
    remove)
      ((${#arguments[@]} == 1)) || die "remove 一次只能接受一个软件 ID"
      platform_detect_identity
      catalog_remove "${arguments[0]}"
      ;;
    ports)
      ((${#arguments[@]} == 0)) || die "ports 不接受参数"
      platform_detect_identity
      network_list_ports
      ;;
    dns)
      ((${#arguments[@]} <= 1)) || die "dns 最多接受一个域名"
      platform_detect_identity
      network_dns_diagnose "${arguments[0]:-}"
      ;;
    dns-config|proxy|net-tuning|tuning-adapters)
      ((${#arguments[@]} == 0)) || die "$command 不接受参数"
      platform_detect_identity
      case "$command" in
        dns-config) network_dns_menu ;; proxy) network_proxy_menu ;;
        net-tuning) network_tuning_menu ;; tuning-adapters) network_tuning_adapter_menu ;;
      esac
      ;;
    proxy-check)
      ((${#arguments[@]} == 1)) || die "proxy-check 需要一个 HTTP / HTTPS URL"
      valid_http_url "${arguments[0]}" || die "URL 格式无效"
      network_proxy_check "${arguments[0]}"
      ;;
    probe)
      ((${#arguments[@]} == 2)) || die "probe 需要目标和 TCP 端口"
      network_endpoint_probe "${arguments[0]}" "${arguments[1]}"
      ;;
    http)
      ((${#arguments[@]} == 1)) || die "http 需要且只接受一个完整 URL"
      network_http_diagnose "${arguments[0]}"
      ;;
    trace)
      ((${#arguments[@]} == 1)) || die "trace 需要且只接受一个目标"
      network_path_trace "${arguments[0]}"
      ;;
    interface)
      ((${#arguments[@]} == 1)) || die "interface 需要且只接受一个网络接口名"
      valid_network_interface "${arguments[0]}" || die "网络接口名称格式无效"
      network_interface_detail "${arguments[0]}"
      ;;
    system)
      ((${#arguments[@]} == 0)) || die "system 不接受参数"
      platform_detect_identity
      system_menu
      ;;
    network)
      ((${#arguments[@]} == 0)) || die "network 不接受参数"
      platform_detect_identity
      network_menu
      ;;
    security)
      ((${#arguments[@]} == 0)) || die "security 不接受参数"
      platform_detect_identity
      security_menu
      ;;
    auth-activity)
      ((${#arguments[@]} == 0)) || die "auth-activity 不接受参数"
      security_auth_activity 24
      ;;
    services)
      ((${#arguments[@]} == 0)) || die "services 不接受参数"
      platform_detect_identity
      services_menu
      ;;
    service)
      ((${#arguments[@]} >= 1 && ${#arguments[@]} <= 2)) || die "service 需要服务名，可选一个生命周期动作"
      valid_service_name "${arguments[0]}" || die "服务名格式无效"
      service_exists "${arguments[0]}" || die "没有找到服务：${arguments[0]}"
      if ((${#arguments[@]} == 1)); then
        services_select "${arguments[0]}"
      else
        services_apply_action "${arguments[0]}" "${arguments[1]}"
      fi
      ;;
    journal)
      ((${#arguments[@]} == 0)) || die "journal 不接受参数"
      services_journal_info
      ;;
    logs)
      ((${#arguments[@]} == 1)) || die "logs 需要且只接受一个服务名"
      valid_service_name "${arguments[0]}" || die "服务名格式无效"
      service_exists "${arguments[0]}" || die "没有找到服务：${arguments[0]}"
      services_logs "${arguments[0]}"
      ;;
    apps)
      ((${#arguments[@]} == 0)) || die "apps 不接受参数"
      platform_detect_identity
      apps_menu
      ;;
    app)
      ((${#arguments[@]} == 1)) || die "app 需要且只接受一个应用 ID"
      platform_detect_identity
      record="$(apps_service_record_by_id "${arguments[0]}" 2>/dev/null || true)"
      [[ -n "$record" ]] || die "未知应用 ID：${arguments[0]}"
      service="$(apps_service_unit "${arguments[0]}")"
      service_exists "$service" || die "应用服务未安装：$service"
      apps_service_detail "${arguments[0]}"
      ;;
    compose)
      ((${#arguments[@]} == 1)) || die "compose 需要且只接受一个项目名称"
      platform_detect_identity
      docker_compose_manage "${arguments[0]}"
      ;;
    backups)
      ((${#arguments[@]} == 0)) || die "backups 不接受参数"
      platform_detect_identity
      backups_menu
      ;;
    terminal-check)
      ((${#arguments[@]} == 0)) || die "terminal-check 不接受参数"
      terminal_diagnose
      ;;
    terminal|warp|recovery|changes|project)
      ((${#arguments[@]} == 0)) || die "$command 不接受参数"
      case "$command" in
        terminal) terminal_menu ;; warp) warp_menu ;; recovery) recovery_menu ;;
        changes) recovery_changes_menu ;; project) toolkit_menu ;;
      esac
      ;;
    backup-delete)
      ((${#arguments[@]} == 1)) || die "backup-delete 需要且只接受一个快照编号"
      backup_valid_snapshot "${arguments[0]}" || die "快照编号格式无效"
      backups_delete_snapshot "${arguments[0]}"
      ;;
    backup-cleanup)
      ((${#arguments[@]} == 0)) || die "backup-cleanup 不接受参数"
      backups_cleanup
      ;;
    about)
      ((${#arguments[@]} == 0)) || die "about 不接受参数"
      toolkit_about
      ;;
    self-update)
      ((${#arguments[@]} == 0)) || die "self-update 不接受参数"
      toolkit_self_update
      ;;
    uninstall)
      ((${#arguments[@]} == 0)) || die "uninstall 不接受参数"
      toolkit_uninstall
      ;;
    version) printf 'keine %s\n' "$KEINE_VERSION" ;;
    *) die "未知命令：$command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
